{
  "name": "galaxus-mcp",
  "version": "0.1.0",
  "description": "MCP server for Galaxus.ch / Digitec.ch product search and discovery",
  "type": "module",
  "bin": {
    "galaxus-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "refresh-hashes": "node scripts/refresh-hashes.mjs",
    "check-hashes": "node scripts/check-hashes.mjs",
    "release-hashes": "bash scripts/release-hashes.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "^1.49.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
